{
  "permissions": {
    "allow": [
      "Shell(printenv:*)",
      "Shell(grep:*)",
      "Shell(sed:*)",
      "Shell(curl -s -H Accept: application/json https://api.replicate.com/v1/search?query=text+to+video+fast+short)",
      "Shell(npm:*)",
      "Shell(npx tsc --noEmit 2 >& 1)",
      "Shell(npx next start -p 3100)",
      "Shell(curl -s -o /dev/null -w %{http_code}\\n -X POST http://localhost:3100/api/predictions -H Content-Type: application/json -d {})",
      "Shell(curl -s -X POST http://localhost:3100/api/predictions -H Content-Type: application/json -d {})",
      "Shell(echo:*)",
      "Shell(curl -s -w \\nHTTP %{http_code}\\n -X POST http://localhost:3100/api/predictions -H Content-Type: application/json -d {\"prompt\":\"a cat surfing a wave\"})",
      "Shell(curl -s -w \\nHTTP %{http_code}\\n http://localhost:3100/api/predictions/nonexistent)",
      "Shell(curl -s -o /dev/null -w HTML %{http_code}\\n http://localhost:3100/)",
      "Shell(curl -s http://localhost:3100/)",
      "Shell(npx tsc --noEmit)"
    ],
    "deny": [],
    "defaultMode": "default"
  }
}